[Transfer]
Verify=no

[Source]
Type=url-file
Path=https://github.com/alyraffauf/kyanite-sysexts/releases/download/sysext-lts-docker
MatchPattern=docker-lts-@v-x86-64.raw

[Target]
Type=regular-file
Path=/var/lib/sysupdate
MatchPattern=docker-lts-@v-x86-64.raw
CurrentSymlink=/var/lib/extensions/docker.raw
