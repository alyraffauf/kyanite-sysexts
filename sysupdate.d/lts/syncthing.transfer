[Transfer]
Verify=no

[Source]
Type=url-file
Path=https://github.com/alyraffauf/kyanite-sysexts/releases/download/sysext-lts-syncthing
MatchPattern=syncthing-lts-@v-x86-64.raw

[Target]
Type=regular-file
Path=/var/lib/sysupdate/syncthing-lts
MatchPattern=syncthing-lts-@v-x86-64.raw
CurrentSymlink=/var/lib/extensions/syncthing.raw
